AGENT_PROVIDER=laya
# Real Laya selects tools/scripts after each observation. workflow retains the old fixed-tool path.
AGENT_MODE=agentic
LAYA_ENDPOINT=http://127.0.0.1:8000/v1/systemone
LAYA_MODEL=typed-decisions
# Separate local CPU YOLO11n evidence tool. Start with npm run model:vision.
VISION_ENDPOINT=http://127.0.0.1:8001/infer
# Set LAYA_API_KEY only for an authenticated remote endpoint.
# The server reads environment variables; copy these into the shell or use Node --env-file.
STORE_BACKEND=local
